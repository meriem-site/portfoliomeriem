{
  "functions": {
    "api/*.php": {
      "runtime": "vercel-php@0.9.0"
    }
  },
  "routes": [
    {
      "src": "^/$",
      "dest": "/api/index.php"
    },
    {
      "src": "^/module$",
      "dest": "/api/module.php"
    },
    {
      "src": "^/projets$",
      "dest": "/api/projets.php"
    },
    {
      "src": "^/(.*\\.php)$",
      "dest": "/api/$1"
    }
  ]
}